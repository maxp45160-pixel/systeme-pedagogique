# Copier en `.env.local` (ignoré par git) et renseigner les valeurs.
# Supabase Studio › Project Settings › API

# URL du projet, ex. https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Clé « anon / public ». Publique par construction : elle est envoyée au
# navigateur, et c'est RLS qui protège les données, pas le secret de la clé.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NE JAMAIS mettre ici la clé `service_role` : elle contourne RLS et donnerait
# à n'importe quel visiteur l'accès aux données de tous les comptes.

# Clé Anthropic pour le tuteur (facultatif, côté serveur uniquement).
ANTHROPIC_API_KEY=
