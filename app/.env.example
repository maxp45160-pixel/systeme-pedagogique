# Copier en `.env.local` (ignoré par git) et renseigner les valeurs.
# Supabase Studio › Project Settings › API

# URL du projet, ex. https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Clé « anon / public ». Publique par construction : elle est envoyée au
# navigateur, et c'est RLS qui protège les données, pas le secret de la clé.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NE JAMAIS mettre ici la clé `service_role` : elle contourne RLS et donnerait
# à n'importe quel visiteur l'accès aux données de tous les comptes.

# ------------------------------------------------------------------
# Moteur du tuteur (ADR-007) — facultatif, côté serveur uniquement.
#
# Sans aucun moteur configuré, le tuteur répond 503 et l'interface bascule
# sur « copier le contexte ». Ce n'est pas une panne : c'est le repli prévu.
#
# ⚠️ « Moteur » = fournisseur de modèle. À ne pas confondre avec les
# « dorsales » de lib/store/db.ts, qui désignent le stockage des données.
# ------------------------------------------------------------------

# anthropic | compatible-openai | auto  (défaut : auto)
# En « auto », un palier gratuit correctement renseigné a la priorité.
TUTEUR_MOTEUR=

# --- Palier gratuit : tout service exposant {base}/chat/completions ---
# Groq       TUTEUR_URL_BASE=https://api.groq.com/openai/v1
#            TUTEUR_MODELE=llama-3.3-70b-versatile
# OpenRouter TUTEUR_URL_BASE=https://openrouter.ai/api/v1
TUTEUR_CLE=
TUTEUR_URL_BASE=
TUTEUR_MODELE=

# ⚠️ Les paliers gratuits s'entraînent généralement sur les données envoyées.
# Le contexte du tuteur contient un profil de compétences — donnée personnelle.
# Acceptable tant que le seul profil réel est le tien ; à réexaminer avant
# qu'un utilisateur tiers s'inscrive (ADR-009).

# --- Moteur Anthropic (payant) ---
# TUTEUR_MODELE le surcharge s'il est renseigné ; défaut claude-opus-4-8.
ANTHROPIC_API_KEY=
