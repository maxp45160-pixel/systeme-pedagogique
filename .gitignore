# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/app/node_modules
/app/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/app/coverage

# next.js
/app/.next/
/app/out/

# production
/app/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# Le gabarit ne contient aucune valeur : il documente les variables attendues.
!/app/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Le journal d'événements (app/data/store/) est VOLONTAIREMENT versionné :
# c'est le profil réel de l'utilisateur (application mono-utilisateur), pas du
# cache jetable. Seuls les fichiers de tentatives en cours sont ignorés — ils
# reflètent un exercice non terminé, sans valeur d'historique.
/app/data/store/attempts.json

# Fichier de permissions local Claude Code — personnel, ne doit pas être partagé
.claude/settings.local.json

# Local MCP configuration
.mcp.json

