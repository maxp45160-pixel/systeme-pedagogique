{
  "name": "systeme-pedagogique-root",
  "private": true,
  "workspaces": [
    "app"
  ],
  "scripts": {
    "build": "npm run build --workspace=app",
    "dev": "npm run dev --workspace=app",
    "start": "npm run start --workspace=app",
    "lint": "npm run lint --workspace=app",
    "test": "npm run test --workspace=app",
    "verify": "npm run agents:check && npm run agents:test && npm run verify --workspace=app",
    "agents:check": "node ai-company/scripts/check.mjs && node ai-company/scripts/missions.mjs check",
    "agents:test": "node --test ai-company/scripts/*.test.mjs",
    "agents:next": "node ai-company/scripts/missions.mjs next",
    "agents:resume": "node ai-company/scripts/context.mjs --resume"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-linux-x64-gnu": "4.3.3",
    "lightningcss-linux-x64-gnu": "1.32.0"
  }
}
